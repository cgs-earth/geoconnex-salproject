# Generated by sal init. The commands this SAL project runs, so that
# `make <target>` documents them; each target is one command, and none needs
# make. `make help` lists them.
#
# SOURCES are the RDF files or directories sal validates and builds; empty
# means the whole project. MESSAGE is what a build changes, recorded in the
# snapshot like a git commit message: make build MESSAGE="Add the gauges".
# BUCKET is where sal upload copies .sal/data: the bucket terraform created,
# or name one with BUCKET=gs://my-bucket/.
SOURCES ?=
MESSAGE ?=
TF_DIR ?= terraform
BUCKET ?= $(shell terraform -chdir=$(TF_DIR) output -raw bucket_url 2>/dev/null)

# The build runs in a Cloud Run job, not locally; see terraform/README.md.
PROJECT ?= $(shell awk -F'"' '/^project[ ]*=/{print $$2}' $(TF_DIR)/terraform.tfvars)
REGION ?= us-central1
NAME ?= geoconnex-salproject
IMAGE_REPO ?= $(REGION)-docker.pkg.dev/$(PROJECT)/$(NAME)

$(TF_DIR)/.terraform:
	terraform -chdir=$(TF_DIR) init

.PHONY: registry infra images job-run help validate build run construct query sparql serve clean iac plan apply destroy upload

validate: ## check every RDF source against its vocabularies; commits nothing
	sal validate $(SOURCES)

build: ## validate, run SAL module tasks and CONSTRUCT queries, and commit the new triples to .sal/data; needs MESSAGE="..."
	sal build --message "$(MESSAGE)" $(SOURCES)

query: ## SQL shell over the built triples table
	sal query

serve: ## SPARQL endpoint and web UI at http://localhost:8080
	sal serve --with-ui

plan: $(TF_DIR)/.terraform ## show what apply would change on Google Cloud
	terraform -chdir=$(TF_DIR) plan

apply: $(TF_DIR)/.terraform ## create or update everything, including the Cloud Run service; run after make job-run has filled the bucket
	terraform -chdir=$(TF_DIR) apply

destroy: $(TF_DIR)/.terraform ## remove the Cloud Run service and the bucket
	terraform -chdir=$(TF_DIR) destroy

upload: ## copy .sal/data to the bucket, after a build
	@test -n "$(BUCKET)" || { echo "no bucket: run make apply first, or BUCKET=gs://my-bucket/ make upload"; exit 1; }
	sal upload --bucket $(BUCKET)

infra: $(TF_DIR)/.terraform ## create the bucket, the build job, and the service accounts, but not the service (it cannot start until the job has filled the bucket)
	terraform -chdir=$(TF_DIR) apply -var deploy_service=false

registry: $(TF_DIR)/.terraform ## create the Artifact Registry repository the images are pushed to
	terraform -chdir=$(TF_DIR) apply -target=google_artifact_registry_repository.images

images: ## build and push the service and job images with Cloud Build
	gcloud builds submit --project $(PROJECT) --config cloudbuild.yaml --substitutions _REPO=$(IMAGE_REPO) .

job-run: ## run the build job: sal build the Geoconnex graph, upload it, roll the service
	gcloud run jobs execute $(NAME)-sal-build --project $(PROJECT) --region $(REGION) --wait
