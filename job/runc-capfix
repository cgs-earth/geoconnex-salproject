#!/usr/bin/env bash
#
# An OCI runtime for dockerd that is runc with one change: before a container is
# created, the capabilities its config.json asks for are cut down to the ones
# this process is actually allowed to hold.
#
# Docker gives every container a default set (MKNOD, NET_RAW, AUDIT_WRITE, ...).
# On Cloud Run the job does not hold all of them, and runc then fails with
# "unable to apply caps: can't apply capabilities: operation not permitted".
# Containers that need only what the job has run unchanged.
set -euo pipefail

CAPS=(chown dac_override dac_read_search fowner fsetid kill setgid setuid setpcap
	linux_immutable net_bind_service net_broadcast net_admin net_raw ipc_lock ipc_owner
	sys_module sys_rawio sys_chroot sys_ptrace sys_pacct sys_admin sys_boot sys_nice
	sys_resource sys_time sys_tty_config mknod lease audit_write audit_control setfcap
	mac_override mac_admin syslog wake_alarm block_suspend audit_read perfmon bpf
	checkpoint_restore)

bundle=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
	case "${args[i]}" in
	--bundle | -b) bundle="${args[i + 1]:-}" ;;
	--bundle=*) bundle="${args[i]#*=}" ;;
	esac
done

if [ -n "$bundle" ] && [ -f "$bundle/config.json" ]; then
	bnd="$(awk '/^CapBnd:/{print $2}' /proc/self/status)"
	allowed='[]'
	for ((bit = 0; bit < ${#CAPS[@]}; bit++)); do
		if (((0x$bnd >> bit) & 1)); then
			allowed="$(jq -c --arg c "CAP_${CAPS[bit]^^}" '. + [$c]' <<<"$allowed")"
		fi
	done
	tmp="$(mktemp)"
	jq --argjson allowed "$allowed" '
		if .process.capabilities then
			.process.capabilities |= with_entries(.value |= map(select(. as $c | $allowed | index($c))))
		else . end' "$bundle/config.json" >"$tmp"
	cat "$tmp" >"$bundle/config.json"
	rm -f "$tmp"
fi

exec runc "$@"
