# Generated by sal terraform, then changed for this project. Edit freely; sal
# will not write over this file unless asked with --force.
#
#   - an ephemeral Compute Engine VM (created by `make job-run` from an instance
#     template, deleted when it finishes) builds the Geoconnex graph (sal build)
#     and uploads it to the bucket; see README.md for the order to apply things in
#   - a Cloud Run SERVICE copies the bucket onto local disk when an instance
#     starts and runs sal serve over the copy, rather than mounting the bucket
#     with Cloud Storage FUSE as sal terraform generates
#   - an Artifact Registry repository holds the two images (make images)
#
# No key is stored anywhere: each service account's access to the bucket is all
# the credential there is. Everything is in one region.

terraform {
  required_version = ">= 1.5"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = ">= 6.0"
    }
  }
}

provider "google" {
  project = var.project
  region  = var.region
}

locals {
  # Bucket names are global, so the project ID is part of the default.
  bucket_name = coalesce(var.bucket, "${var.project}-${var.name}-sal")

  repo_url    = "${var.region}-docker.pkg.dev/${var.project}/${var.name}"
  serve_image = coalesce(var.serve_image, "${local.repo_url}/serve:latest")
  job_image   = coalesce(var.job_image, "${local.repo_url}/job:latest")
}

resource "google_project_service" "run" {
  service            = "run.googleapis.com"
  disable_on_destroy = false
}

# The data product. sal upload writes the whole .sal/data layout here: the
# Iceberg table under <name>/triples, the pinned vocabulary documents under
# blobs/, and the STAC catalog under stac/.
resource "google_storage_bucket" "data" {
  name                        = local.bucket_name
  location                    = var.region
  storage_class               = "STANDARD"
  uniform_bucket_level_access = true
  public_access_prevention    = "enforced"
  force_destroy               = var.bucket_force_destroy

  versioning {
    enabled = false
  }
}

resource "google_project_service" "artifactregistry" {
  service            = "artifactregistry.googleapis.com"
  disable_on_destroy = false
}

resource "google_project_service" "cloudbuild" {
  service            = "cloudbuild.googleapis.com"
  disable_on_destroy = false
}

# Holds the serve and job images that cloudbuild.yaml builds.
resource "google_artifact_registry_repository" "images" {
  repository_id = var.name
  location      = var.region
  format        = "DOCKER"

  depends_on = [google_project_service.artifactregistry]
}

# ---------------------------------------------------------------- build VM

# The build runs on an ephemeral Compute Engine VM, not in Cloud Run: Cloud
# Run's filesystem is in memory, so the whole working copy of the table, the
# Docker images and DuckDB would share one memory limit. The VM works on its
# boot disk instead. `make job-run` creates a VM from the template below; the
# VM runs the job image (sal build, sal upload, roll the service) and then
# deletes itself. If it never gets that far, its max run duration deletes it.

resource "google_project_service" "compute" {
  service            = "compute.googleapis.com"
  disable_on_destroy = false
}

# The identity the build VM runs as: it writes the data product to the bucket,
# pulls the job image, writes logs, asks the service for a new revision so that
# it picks the data up, and deletes its own VM.
resource "google_service_account" "build" {
  account_id   = "${var.name}-sal-build"
  display_name = "sal build VM for ${var.name}"
}

resource "google_storage_bucket_iam_member" "build_writes_data" {
  bucket = google_storage_bucket.data.name
  role   = "roles/storage.objectAdmin"
  member = "serviceAccount:${google_service_account.build.email}"
}

resource "google_artifact_registry_repository_iam_member" "build_pulls_image" {
  project    = var.project
  location   = google_artifact_registry_repository.images.location
  repository = google_artifact_registry_repository.images.name
  role       = "roles/artifactregistry.reader"
  member     = "serviceAccount:${google_service_account.build.email}"
}

resource "google_project_iam_member" "build_writes_logs" {
  project = var.project
  role    = "roles/logging.logWriter"
  member  = "serviceAccount:${google_service_account.build.email}"
}

# Only VMs named <name>-sal-build-*, so that the identity can delete the build
# VMs and nothing else.
resource "google_project_iam_member" "build_deletes_itself" {
  project = var.project
  role    = "roles/compute.instanceAdmin.v1"
  member  = "serviceAccount:${google_service_account.build.email}"

  condition {
    title      = "only build VMs"
    expression = "resource.type == \"compute.googleapis.com/Instance\" && resource.name.extract(\"/instances/{name}\").startsWith(\"${var.name}-sal-build-\")"
  }
}

# What `make job-run` creates a VM from. The settings that change between runs
# (the sitemap filters) are metadata, copied into the template when terraform
# applies; the VM's startup script reads them.
resource "google_compute_instance_template" "build" {
  name_prefix  = "${var.name}-sal-build-"
  description  = "Ephemeral VM that builds the ${var.name} data product and deletes itself"
  machine_type = var.build_machine_type

  disk {
    source_image = "projects/cos-cloud/global/images/family/cos-stable"
    disk_size_gb = var.build_disk_size_gb
    disk_type    = "pd-ssd"
    boot         = true
    auto_delete  = true
  }

  network_interface {
    network    = var.build_network
    subnetwork = var.build_subnetwork

    # An ephemeral external address, so the VM can reach the Geoconnex catalog,
    # the vocabulary publishers and Docker Hub without a Cloud NAT.
    access_config {}
  }

  service_account {
    email  = google_service_account.build.email
    scopes = ["cloud-platform"]
  }

  scheduling {
    automatic_restart   = false
    on_host_maintenance = "MIGRATE"

    # The backstop: the VM is deleted this long after it starts, whatever it is
    # doing, so a hung build never runs up a bill.
    instance_termination_action = "DELETE"
    max_run_duration {
      seconds = var.build_timeout_seconds
    }
  }

  metadata = {
    startup-script   = file("${path.module}/../job/build-vm-startup.sh")
    image            = local.job_image
    bucket           = "gs://${google_storage_bucket.data.name}/"
    include-sitemaps = var.include_sitemaps
    exclude-sitemaps = var.exclude_sitemaps
    service-url      = var.deploy_service ? "https://run.googleapis.com/v2/projects/${var.project}/locations/${var.region}/services/${var.name}-sal" : ""
  }

  lifecycle {
    create_before_destroy = true
  }

  depends_on = [
    google_project_service.compute,
    google_storage_bucket_iam_member.build_writes_data,
    google_artifact_registry_repository_iam_member.build_pulls_image,
  ]
}

# ------------------------------------------------------------------ service

# The identity the service runs as, with read access to the bucket and
# nothing else.
resource "google_service_account" "serve" {
  account_id   = "${var.name}-sal-serve"
  display_name = "sal serve for ${var.name}"
}

resource "google_storage_bucket_iam_member" "serve_reads_data" {
  bucket = google_storage_bucket.data.name
  role   = "roles/storage.objectViewer"
  member = "serviceAccount:${google_service_account.serve.email}"
}

# The service copies the bucket onto local disk when an instance starts and
# serves that copy. Cloud Run's filesystem is in memory, so the table counts
# against `memory`, and nothing listens until the copy is done, which is what
# the startup probe waits for. Turn deploy_service off for the first apply: it
# cannot start until the job has put something in the bucket.
resource "google_cloud_run_v2_service" "serve" {
  count = var.deploy_service ? 1 : 0

  name                = "${var.name}-sal"
  location            = var.region
  ingress             = "INGRESS_TRAFFIC_ALL"
  deletion_protection = false

  template {
    service_account                  = google_service_account.serve.email
    timeout                          = "${var.request_timeout_seconds}s"
    max_instance_request_concurrency = var.concurrency

    scaling {
      min_instance_count = var.min_instances
      max_instance_count = var.max_instances
    }

    containers {
      image = local.serve_image

      ports {
        container_port = 8080
      }

      env {
        name  = "BUCKET_NAME"
        value = google_storage_bucket.data.name
      }
      env {
        name  = "WITH_UI"
        value = var.with_ui ? "1" : ""
      }

      resources {
        limits = {
          cpu    = var.cpu
          memory = var.memory
        }
        # CPU is only allocated while a request is being handled, which is
        # what makes an idle service free. startup_cpu_boost speeds the copy.
        cpu_idle          = true
        startup_cpu_boost = true
      }

      startup_probe {
        initial_delay_seconds = 5
        period_seconds        = 10
        failure_threshold     = var.startup_failure_threshold

        tcp_socket {
          port = 8080
        }
      }
    }
  }

  # The build VM sets this label to force a new revision after an upload.
  lifecycle {
    ignore_changes = [template[0].labels]
  }

  depends_on = [
    google_project_service.run,
    google_storage_bucket_iam_member.serve_reads_data,
  ]
}

# After an upload the build VM patches the service so that a new revision
# starts, and its instances copy the new data. That needs permission to update
# the service, and to act as the identity the service runs as.
resource "google_cloud_run_v2_service_iam_member" "build_updates_service" {
  count = var.deploy_service ? 1 : 0

  name     = google_cloud_run_v2_service.serve[0].name
  location = google_cloud_run_v2_service.serve[0].location
  role     = "roles/run.developer"
  member   = "serviceAccount:${google_service_account.build.email}"
}

resource "google_service_account_iam_member" "build_acts_as_serve" {
  service_account_id = google_service_account.serve.name
  role               = "roles/iam.serviceAccountUser"
  member             = "serviceAccount:${google_service_account.build.email}"
}

# A SPARQL endpoint is usually meant to be queried by anyone; set public to
# false to require an identity token instead.
resource "google_cloud_run_v2_service_iam_member" "public" {
  count = var.deploy_service && var.public ? 1 : 0

  name     = google_cloud_run_v2_service.serve[0].name
  location = google_cloud_run_v2_service.serve[0].location
  role     = "roles/run.invoker"
  member   = "allUsers"
}
