# Generated by sal terraform. The defaults are deliberately small: one CPU,
# the memory DuckDB needs to open an Iceberg table with the spatial extension
# loaded, no instance kept warm, and at most two instances, so that an idle
# deployment costs nothing beyond the bucket. Raise them for a busier endpoint
# or a larger table.

variable "project" {
  description = "The Google Cloud project ID to deploy into."
  type        = string

  validation {
    condition     = length(var.project) > 0
    error_message = "Set project in terraform.tfvars (or TF_VAR_project) to the Google Cloud project ID."
  }
}

variable "region" {
  description = "The region the bucket and the Cloud Run service are created in. Keep them in one region so queries never cross regions."
  type        = string
  default     = "us-central1"
}

variable "name" {
  description = "The name of the data product: the git repository name, which is the namespace the Iceberg table sits under and names the service and the bucket."
  type        = string
  default     = "geoconnex-salproject"

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{0,29}$", var.name))
    error_message = "name must be lowercase letters, digits, and hyphens, start with a letter, and be at most 30 characters."
  }
}

variable "bucket" {
  description = "The name of the bucket holding the data product. Defaults to <project>-<name>-sal, since bucket names are global."
  type        = string
  default     = null
}

variable "bucket_force_destroy" {
  description = "Whether terraform destroy deletes the bucket with the data product still in it. Off, so that a destroy never deletes data by accident; empty the bucket first or set this to true."
  type        = bool
  default     = false
}

variable "public" {
  description = "Whether anyone may call the service. Off requires a Google identity token on every request."
  type        = bool
  default     = true
}

variable "with_ui" {
  description = "Whether sal serve also serves its browser UI. The UI's /api/sql endpoint runs arbitrary DuckDB statements and /api/table points the queries at any bucket a caller names, so leave this off on a public service unless that is acceptable."
  type        = bool
  default     = false
}

variable "cpu" {
  description = "CPU limit of an instance."
  type        = string
  default     = "1"
}

variable "memory" {
  description = "Memory limit of an instance. DuckDB holds the Iceberg manifests and the spatial extension in memory; raise this for a large table."
  type        = string
  default     = "2Gi"
}

variable "min_instances" {
  description = "Instances kept warm. Zero means the first request after idle pays the cold start; one keeps the endpoint responsive at a steady cost."
  type        = number
  default     = 0
}

variable "max_instances" {
  description = "The most instances the service scales to."
  type        = number
  default     = 2
}

variable "concurrency" {
  description = "Requests an instance handles at once. Every query runs on one DuckDB handle, so this bounds how many share it."
  type        = number
  default     = 20
}

variable "request_timeout_seconds" {
  description = "How long a request, and so a query, may take."
  type        = number
  default     = 300
}

variable "deploy_service" {
  description = "Whether to create the Cloud Run service. The service cannot start until the build job has put the data product in the bucket, so apply once with this false, run the job, then apply again with it true."
  type        = bool
  default     = true
}

variable "startup_failure_threshold" {
  description = "How many 10 second startup probes may fail before an instance is given up on. The instance copies the whole data product from the bucket before it listens, so a big table needs a big number."
  type        = number
  default     = 30
}

variable "serve_image" {
  description = "The service image. Defaults to serve:latest in this project's Artifact Registry repository, which make images builds."
  type        = string
  default     = null
}

variable "job_image" {
  description = "The build job image. Defaults to job:latest in this project's Artifact Registry repository, which make images builds."
  type        = string
  default     = null
}

variable "job_cpu" {
  description = "CPU limit of the build job."
  type        = string
  default     = "8"
}

variable "job_memory" {
  description = "Memory limit of the build job. Cloud Run's filesystem is in memory, so the job's working copy of the table, the Docker daemon's images, and DuckDB all share this. The full Geoconnex harvest is about 9 GB of compressed JSON-LD; 32Gi is the most a job gets with 8 CPUs."
  type        = string
  default     = "32Gi"
}

variable "job_timeout_seconds" {
  description = "How long the build job may run."
  type        = number
  default     = 43200
}

variable "include_sitemaps" {
  description = "Comma separated Geoconnex sitemap_ids to harvest, such as ref:dams,ref:states. Empty harvests all of them. For a quick test run."
  type        = string
  default     = ""
}

variable "exclude_sitemaps" {
  description = "Comma separated Geoconnex sitemap_ids to skip, such as usgs:national_geologic_map. Ignored when include_sitemaps is set."
  type        = string
  default     = ""
}

variable "docker_host" {
  description = "A Docker daemon for the build job to use instead of starting one in the job, such as tcp://10.0.0.5:2375. Empty starts dockerd inside the job."
  type        = string
  default     = ""
}
