# Generated by sal terraform.

output "service_url" {
  description = "Where the service answers; /sparql is the SPARQL endpoint and /stac/catalog.json the STAC catalog."
  value       = one(google_cloud_run_v2_service.serve[*].uri)
}

output "sparql_endpoint" {
  value = var.deploy_service ? "${google_cloud_run_v2_service.serve[0].uri}/sparql" : null
}

output "bucket" {
  description = "The bucket holding the data product."
  value       = google_storage_bucket.data.name
}

output "bucket_url" {
  description = "What to pass to sal upload --bucket: the bucket root, so that the whole .sal/data layout is uploaded."
  value       = "gs://${google_storage_bucket.data.name}/"
}

output "service_account" {
  value = google_service_account.serve.email
}

output "image_repository" {
  description = "Where make images pushes the serve and job images."
  value       = local.repo_url
}

output "build_template" {
  description = "The instance template make job-run creates the ephemeral build VM from."
  value       = google_compute_instance_template.build.name
}

output "build_zone" {
  description = "The zone make job-run creates the build VM in."
  value       = coalesce(var.build_zone, "${var.region}-a")
}
